flowchart TB
    CI["Developer / CI release tooling"] -->|"Signed SDOT + manifest"| SRV["Release server"]
    SRV -->|"MQTTS update command"| GW["ESP32 gateway"]
    SRV -->|"HTTPS manifest + artifact"| GW
    GW -->|"COBS + CRC32 over UART"| APP["STM32 application"]
    APP -->|"Stage artifact + download checkpoint"| EXT["W25Q32 SPI NOR"]
    APP -->|"Persist ARTIFACT_READY in internal metadata, then reset"| BL["STM32 bootloader"]
    BL <-->|"Verify / reconstruct / backup"| EXT
    BL -->|"Install / rollback"| IF["STM32 internal application Flash"]
    BL -->|"Trial boot via reset-vector jump"| APP
    APP -->|"Confirm via internal metadata, then reset"| BL
