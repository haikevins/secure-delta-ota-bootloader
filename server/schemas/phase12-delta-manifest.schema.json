{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secure-delta-ota/phase12-delta-manifest.schema.json",
  "title": "Secure Delta OTA Phase 12 Delta Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_type",
    "patch_format",
    "base_version",
    "target_version",
    "target_load_address",
    "base_size",
    "target_size",
    "patch_size",
    "patch_ratio",
    "savings_percent",
    "selection_threshold_percent",
    "delta_eligible",
    "base_sha256",
    "target_sha256",
    "patch_sha256",
    "patch_crc32",
    "target_crc32",
    "base_vector",
    "target_vector",
    "operations",
    "verification",
    "phase13_note"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "artifact_type": {
      "const": "delta"
    },
    "patch_format": {
      "const": "jojodiff-compatible-v1"
    },
    "base_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "target_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "target_load_address": {
      "const": "0x08006000"
    },
    "base_size": {
      "type": "integer",
      "minimum": 8,
      "maximum": 38912
    },
    "target_size": {
      "type": "integer",
      "minimum": 8,
      "maximum": 38912
    },
    "patch_size": {
      "type": "integer",
      "minimum": 1
    },
    "patch_ratio": {
      "type": "number",
      "minimum": 0
    },
    "savings_percent": {
      "type": "number"
    },
    "selection_threshold_percent": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 100
    },
    "delta_eligible": {
      "type": "boolean"
    },
    "base_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_crc32": {
      "type": "string",
      "pattern": "^0x[0-9A-F]{8}$"
    },
    "target_crc32": {
      "type": "string",
      "pattern": "^0x[0-9A-F]{8}$"
    },
    "base_vector": {
      "type": "object"
    },
    "target_vector": {
      "type": "object"
    },
    "operations": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "phase13_note": {
      "type": "string"
    }
  }
}
