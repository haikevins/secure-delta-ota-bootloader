menu "Secure Delta OTA Phase 10"

config SDOTA_STM32_UART_NUM
    int "STM32 UART controller"
    range 1 2
    default 2
    help
        UART0 is reserved for ESP-IDF console. UART2 is the default on ESP32.

config SDOTA_STM32_UART_TX_GPIO
    int "ESP32 TX GPIO -> STM32 PA10"
    range 0 39
    default 17

config SDOTA_STM32_UART_RX_GPIO
    int "ESP32 RX GPIO <- STM32 PA9"
    range 0 39
    default 16


config SDOTA_PHASE10_GATEWAY_TASK_STACK_SIZE
    int "Phase-10 gateway worker task stack size (bytes)"
    range 8192 32768
    default 16384
    help
        Stack for the dedicated Phase-10 Wi-Fi/TLS/HTTPS/UART worker task.
        The complete HTTPS pipeline is intentionally not run on app_main's
        system main task.

config SDOTA_PHASE10_AUTORUN
    bool "Run Phase-10 HTTPS -> STM32 OTA flow on boot"
    default y

config SDOTA_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config SDOTA_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config SDOTA_HTTPS_URL
    string "HTTPS URL of raw STM32 application binary"
    default ""

config SDOTA_PHASE10_UPDATE_ID
    hex "Phase-10 STM32 update ID"
    default 0xA00A0001

config SDOTA_PHASE10_TARGET_VERSION
    int "Downloaded STM32 target version"
    range 1 4294967295
    default 2

config SDOTA_WIFI_TIMEOUT_MS
    int "Wi-Fi connection timeout (ms)"
    range 1000 120000
    default 30000

config SDOTA_SNTP_TIMEOUT_MS
    int "SNTP synchronization timeout (ms)"
    range 1000 120000
    default 20000

config SDOTA_HTTPS_TIMEOUT_MS
    int "HTTPS inactivity/connection timeout (ms)"
    range 1000 120000
    default 15000

endmenu
